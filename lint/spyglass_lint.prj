## SpyGlass lint project for spi_core
## Run from this folder:   spyglass -project spyglass_lint.prj -batch
## or open in GUI:         spyglass -project spyglass_lint.prj

set_option incdir ../rtl
read_file -type verilog {
  ../rtl/apb_slave.v
  ../rtl/baud_generator.v
  ../rtl/spi_slave_select.v
  ../rtl/shifter.v
  ../rtl/spi_core.v
}
set_option top spi_core
set_option language_mode verilog

current_goal lint/lint_rtl -top spi_core
run_goal
